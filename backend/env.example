# SmartPark Backend Configuration
# Copy this file to backend/.env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Database (MongoDB URI)
MONGO_URI=mongodb://localhost:27017/smartpark

# Security
JWT_SECRET=SmartParkJWTSecret2024!@#StrongRandomKey
ADMIN_KEY=SmartParkAdmin2024

# CORS & Frontend
FRONTEND_URL=https://saiful1253.github.io
CORS_ORIGIN=https://saiful1253.github.io

# Email (SMTP via Nodemailer OR Gmail API)
# Option A: SMTP (simplest)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=SmartPark

# Option B: Gmail API (requires OAuth2 credentials from Google Cloud Console)
# GMAIL_CLIENT_ID=your-client-id
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token
# GMAIL_ACCESS_TOKEN=your-access-token

# AI License Plate Recognition (LPR/ANPR)
# Get your free key at https://platerecognizer.com
LPR_API_KEY=your-platerecognizer-api-key
LPR_DEFAULT_REGIONS=us,eu,bd
LPR_CONFIDENCE_THRESHOLD=0.7

# Intertraff VMM (alternative LPR provider)
# Get your key at https://www.intertraff.com
INTERTRAFF_API_KEY=your-intertraff-api-key
INTERTRAFF_API_URL=http://84.200.6.42:5000/ObjectDetection
INTERTRAFF_REGION=eu
